root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# 명시적 import (와일드카드 금지)
ktlint_standard_no-wildcard-imports = enabled
# 테스트의 backtick 한글 시나리오 함수명 허용
ktlint_function_naming_ignore_when_annotated_with = Test, ParameterizedTest

[*.{yml,yaml,json}]
indent_size = 2

[*.gradle.kts]
max_line_length = off
